# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas > Clusters > Connect > Drivers > Node.js
# Ensure username and password are set, and database name is specified (e.g. /pennywise)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pennywise?retryWrites=true&w=majority

# Session Security Secret
# Generate a long, random secret for signing session cookies (minimum 32 characters)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
